---
// src/components/BaseHead.astro
//
// Universal SEO head — included by EVERY layout.
// Fixes from v1:
//   - Removed Atkinson font preloads (not used in Abyss system)
//   - Google Fonts preconnect moved here (was duplicated in every layout)
//   - Canonical URL, OG, Twitter cards all present
//   - hreflang support for multilingual content
//   - No global.css import (conflicts with Abyss inline styles)

import { SITE_TITLE } from '../consts';

interface Props {
    title:        string;
    description?: string;
    language?:    string;   // ISO 639-1 e.g. "ja", "en", "es"
    canonicalUrl?: string;  // Override if needed
    ogImage?:     string;   // Absolute URL to OG image
    type?:        'website' | 'article';
    publishDate?: string;   // ISO date string for articles
}

const {
    title,
    description = '',
    language    = 'en',
    ogImage,
    type        = 'website',
    publishDate,
} = Astro.props;

const siteUrl      = Astro.site ?? new URL('https://global-nexus-blog.pages.dev');
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const fullTitle    = title === SITE_TITLE ? title : `${title} — ${SITE_TITLE}`;

// OG image fallback — use a default if none provided
const ogImageUrl = ogImage
    ? new URL(ogImage, siteUrl).href
    : new URL('/og-default.png', siteUrl).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Verification -->
<meta name="impact-site-verification" value="436ca203-bef8-422c-b48c-a053e3d50baa" />

<!-- Canonical & alternate -->
<link rel="canonical" href={canonicalURL} />

<!-- Sitemap & feeds -->
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', siteUrl)} />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />

<!-- Fonts — preconnect first, then load -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap"
    rel="stylesheet"
/>

<!-- Primary meta -->
<title>{fullTitle}</title>
<meta name="title"       content={fullTitle} />
<meta name="description" content={description} />
<meta name="generator"   content={Astro.generator} />
{language && <meta name="language" content={language} />}

<!-- Open Graph -->
<meta property="og:type"        content={type} />
<meta property="og:url"         content={canonicalURL} />
<meta property="og:title"       content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image"       content={ogImageUrl} />
<meta property="og:site_name"   content={SITE_TITLE} />
{language && <meta property="og:locale" content={language} />}
{type === 'article' && publishDate && (
    <meta property="article:published_time" content={publishDate} />
)}

<!-- Twitter / X -->
<meta name="twitter:card"        content="summary_large_image" />
<meta name="twitter:url"         content={canonicalURL} />
<meta name="twitter:title"       content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image"       content={ogImageUrl} />

<!-- Schema.org JSON-LD -->
{type === 'article' ? (
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": title,
        "description": description,
        "url": canonicalURL.href,
        "publisher": {
            "@type": "Organization",
            "name": SITE_TITLE,
            "url": siteUrl.href
        },
        ...(publishDate ? { "datePublished": publishDate } : {}),
        "inLanguage": language
    })} />
) : (
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": SITE_TITLE,
        "url": siteUrl.href
    })} />
)}