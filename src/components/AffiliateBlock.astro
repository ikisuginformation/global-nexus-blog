---
// src/components/AffiliateBlock.astro
// "Sponsor Plaque" - 広告を「美術展の協賛パネル」に昇華させる

interface Props {
    title: string;
    description: string;
    url: string;
    type?: 'TOOL' | 'BOOK' | 'SERVICE' | 'GEAR';
}

const { title, description, url, type = 'TOOL' } = Astro.props;
---

<a href={url} target="_blank" rel="noopener noreferrer" class="group block w-full border border-black/10 p-8 md:p-12 transition-all duration-700 hover:border-black hover:bg-[#0A0A0A] hover:text-[#FDFDFD] relative overflow-hidden">
    
    <div class="absolute -right-4 -bottom-4 text-[6rem] font-serif font-light leading-none text-black/5 group-hover:text-white/5 pointer-events-none select-none transition-colors duration-700">
        SPONSOR
    </div>

    <div class="relative z-10 flex flex-col md:flex-row justify-between items-start md:items-end gap-8">
        
        <div class="flex flex-col gap-4 max-w-xl">
            <div class="flex items-center gap-4">
                <span class="w-1.5 h-1.5 rounded-full bg-[#D4AF37] opacity-50 group-hover:opacity-100 transition-opacity"></span>
                <span class="text-[9px] font-mono tracking-[0.4em] uppercase text-gray-400 group-hover:text-gray-500 transition-colors">
                    {type} Recommendation
                </span>
            </div>
            
            <div>
                <h4 class="text-2xl md:text-3xl font-serif font-light mb-4 group-hover:italic transition-all duration-500">
                    {title}
                </h4>
                <p class="text-sm font-sans font-light leading-relaxed text-gray-500 group-hover:text-gray-400 transition-colors">
                    {description}
                </p>
            </div>
        </div>

        <div class="shrink-0 flex items-center gap-4 border-b border-transparent group-hover:border-[#D4AF37] pb-1 transition-all duration-500">
            <span class="text-[10px] font-mono tracking-[0.2em] uppercase text-transparent group-hover:text-[#D4AF37] transition-colors duration-500">
                Access
            </span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-gray-300 group-hover:text-[#D4AF37] transition-colors duration-500 transform group-hover:translate-x-1 group-hover:-translate-y-1">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
            </svg>
        </div>
        
    </div>
</a>