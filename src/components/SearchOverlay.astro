---
// src/components/SearchOverlay.astro
// "The Void Search" - 絶対にクラッシュしない堅牢な検索UI

import { getCollection } from 'astro:content';
const posts = await getCollection('blog');

// AIがどんな変なデータを生成しても耐えられるようにする安全処理
const searchData = posts.map(post => {
    let safeDate = "Unknown";
    try {
        if (post.data.date) {
            const d = new Date(post.data.date);
            if (!isNaN(d.getTime())) {
                safeDate = d.toISOString().split('T')[0];
            } else {
                safeDate = String(post.data.date);
            }
        }
    } catch(e) {}

    return {
        title: post.data.title || "No Title",
        description: post.data.description || "",
        slug: post.slug,
        tags: post.data.tags || [],
        date: safeDate
    };
});
---

<div id="search-overlay" class="fixed inset-0 z-[100] bg-[#FDFDFD]/95 backdrop-blur-xl opacity-0 pointer-events-none transition-all duration-700 flex flex-col">
    
    <div class="absolute top-0 right-0 p-8 md:p-12 z-10">
        <button id="close-search-btn" class="text-[10px] font-mono tracking-[0.3em] uppercase text-black hover:text-[#D4AF37] transition-colors flex items-center gap-4 group">
            <span class="w-8 h-[1px] bg-black group-hover:bg-[#D4AF37] transition-colors"></span>
            Close
        </button>
    </div>

    <div class="w-full px-[10vw] pt-[20vh] pb-12 border-b border-black/10 shrink-0">
        <span class="text-[9px] font-mono tracking-[0.4em] uppercase text-gray-400 mb-8 block">Search Archive</span>
        <input 
            type="text" 
            id="search-input" 
            placeholder="Type to explore..." 
            class="w-full bg-transparent text-5xl md:text-8xl font-serif font-light text-black placeholder:text-black/10 outline-none focus:ring-0 border-none p-0"
            autocomplete="off"
        />
    </div>

    <div class="w-full px-[10vw] py-12 overflow-y-auto flex-grow">
        <div id="search-results" class="flex flex-col gap-12 max-w-4xl">
            </div>
    </div>
</div>

<script define:vars={{ searchData }}>
    document.addEventListener('DOMContentLoaded', () => {
        const overlay = document.getElementById('search-overlay');
        const openBtns = document.querySelectorAll('.open-search-btn'); 
        const closeBtn = document.getElementById('close-search-btn');
        const searchInput = document.getElementById('search-input');
        const resultsContainer = document.getElementById('search-results');

        openBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                overlay.classList.remove('opacity-0', 'pointer-events-none');
                setTimeout(() => searchInput.focus(), 100); 
                renderResults(searchData);
            });
        });

        const closeSearch = () => {
            overlay.classList.add('opacity-0', 'pointer-events-none');
            searchInput.value = ''; 
        };
        closeBtn.addEventListener('click', closeSearch);
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeSearch();
        });

        searchInput.addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase();
            const filtered = searchData.filter(post => 
                post.title.toLowerCase().includes(query) || 
                post.description.toLowerCase().includes(query) ||
                post.tags.some(tag => typeof tag === 'string' && tag.toLowerCase().includes(query))
            );
            renderResults(filtered);
        });

        function renderResults(posts) {
            if (posts.length === 0) {
                resultsContainer.innerHTML = '<p class="text-gray-400 font-mono text-sm tracking-widest uppercase">No results found in the void.</p>';
                return;
            }
            resultsContainer.innerHTML = posts.map(post => `
                <a href="/blog/${post.slug}/" class="group block border-l border-black/10 pl-6 hover:border-[#D4AF37] transition-colors">
                    <span class="text-[9px] font-mono tracking-[0.2em] uppercase text-gray-400 block mb-2">${post.date}</span>
                    <h3 class="text-2xl md:text-3xl font-serif font-light text-black group-hover:italic group-hover:text-[#D4AF37] transition-all duration-300">
                        ${post.title}
                    </h3>
                </a>
            `).join('');
        }
    });
</script>