---
// src/components/ArticleCard.astro
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date, language } = post.data;

const formattedDate = date.toLocaleDateString(language === 'ja' ? 'ja-JP' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a href={`/blog/${post.slug}/`} class="article-card">
  <article>
    <header class="card-header">
      <span class="meta-date">{formattedDate}</span>
      <span class="meta-lang">[{language.toUpperCase()}]</span>
    </header>
    <h2 class="card-title">{title}</h2>
    <p class="card-excerpt">{description}</p>
    <div class="card-footer">
      <span class="read-more">Read Article →</span>
    </div>
  </article>
</a>

<style>
  /* 漆器風ガラスカードのスタイル */
  .article-card {
    display: block;
    text-decoration: none;
    /* 背景：漆黒ベースに、ほんのり朱色と金を混ぜた半透明ガラス */
    background: linear-gradient(
      135deg,
      rgba(5, 5, 5, 0.85),  /* 深い黒 */
      rgba(60, 10, 5, 0.7)  /* ほんのり朱色 */
    );
    /* すりガラス効果 */
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    
    /* 枠線：鈍く光る金継ぎのようなゴールド */
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 12px;
    padding: 2rem;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  /* ホバー時のアクション：浮かび上がり、枠線が明るくなる */
  .article-card:hover {
    transform: translateY(-6px);
    border-color: rgba(212, 175, 55, 0.6); /* ゴールドが明るく */
    box-shadow: 0 12px 30px rgba(5, 0, 0, 0.5);
    background: linear-gradient(
      135deg,
      rgba(10, 10, 10, 0.9),
      rgba(80, 20, 10, 0.75)
    );
  }

  /* タイトルなどの文字色 */
  .card-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    /* 羊皮紙のような温かい白 */
    color: #f0e8d8; 
    margin: 0.5rem 0 1rem;
    line-height: 1.3;
  }

  .card-excerpt {
    /* 少し落ち着いた金色 */
    color: rgba(240, 232, 216, 0.8);
    line-height: 1.6;
  }

  .meta-date, .meta-lang, .read-more {
    font-family: monospace;
    font-size: 0.8rem;
    /* アクセントの朱色 */
    color: #d9381e; 
    letter-spacing: 0.05em;
  }
  
  .card-header {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
    opacity: 0.8;
  }
</style>