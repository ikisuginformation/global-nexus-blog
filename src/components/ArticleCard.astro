---
// src/components/ArticleCard.astro
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

// language を削除し、title, description, date のみ取得
const { title, description, date } = post.data;

// 言語判定を捨て、すべて英語（en-US）のフォーマットに固定
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a href={`/blog/${post.slug}/`} class="article-card">
  <article>
    <header class="card-header">
      <span class="meta-date">{formattedDate}</span>
      <span class="meta-lang">[EN]</span>
    </header>
    <h2 class="card-title">{title}</h2>
    <p class="card-excerpt">{description}</p>
    <div class="card-footer">
      <span class="read-more">Read Article →</span>
    </div>
  </article>
</a>

<style>
  /* 漆器風ガラスカードのスタイル */
  .article-card {
    display: block;
    text-decoration: none;
    background: linear-gradient(
      135deg,
      rgba(5, 5, 5, 0.85),
      rgba(60, 10, 5, 0.7)
    );
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: 12px;
    padding: 2rem;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .article-card:hover {
    transform: translateY(-6px);
    border-color: rgba(212, 175, 55, 0.6);
    box-shadow: 0 12px 30px rgba(5, 0, 0, 0.5);
    background: linear-gradient(
      135deg,
      rgba(10, 10, 10, 0.9),
      rgba(80, 20, 10, 0.75)
    );
  }

  .card-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    color: #f0e8d8; 
    margin: 0.5rem 0 1rem;
    line-height: 1.3;
  }

  .card-excerpt {
    color: rgba(240, 232, 216, 0.8);
    line-height: 1.6;
  }

  .meta-date, .meta-lang, .read-more {
    font-family: monospace;
    font-size: 0.8rem;
    color: #d9381e; 
    letter-spacing: 0.05em;
  }
  
  .card-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 1rem;
    opacity: 0.8;
  }

  .card-footer {
    margin-top: 1.5rem;
    text-align: right;
  }
</style>