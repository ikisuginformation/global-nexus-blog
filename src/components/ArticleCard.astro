---
// src/components/ArticleCard.astro
// Glassmorphism article card that floats above the QuantumCanvas abyss.
// Hover: border brightens, inner glow intensifies, slight Y-lift.

export interface Props {
  title:       string;
  excerpt:     string;
  href:        string;
  date?:       string;
  readTime?:   string;
  tags?:       string[];
  /** Optional: dominant accent override per card. Defaults to cyan. */
  accent?:     'cyan' | 'violet' | 'gold';
}

const {
  title,
  excerpt,
  href,
  date,
  readTime,
  tags = [],
  accent = 'cyan',
} = Astro.props;

// Accent colour map
const accentMap = {
  cyan:   { border: 'rgba(0, 212, 255, 0.30)',  glow: 'rgba(0, 212, 255, 0.12)',  tag: '#00d4ff'  },
  violet: { border: 'rgba(155, 93, 229, 0.30)', glow: 'rgba(155, 93, 229, 0.12)', tag: '#9b5de5'  },
  gold:   { border: 'rgba(201, 168, 76, 0.30)', glow: 'rgba(201, 168, 76, 0.12)', tag: '#c9a84c'  },
};
const ac = accentMap[accent];

// Format date if provided
let dateStr = '';
if (date) {
  try {
    dateStr = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(date));
  } catch { dateStr = date; }
}
---

<a href={href} class={`article-card glass-panel accent-${accent}`} style={`--card-border: ${ac.border}; --card-glow: ${ac.glow}; --card-tag: ${ac.tag};`}>

  <!-- ── Animated shimmer line at top edge ───────────────────────────── -->
  <div class="card-shimmer" aria-hidden="true"></div>

  <!-- ── Card body ──────────────────────────────────────────────────── -->
  <div class="card-content">

    <!-- Meta row -->
    {(date || readTime) && (
      <div class="card-meta">
        {dateStr && <time datetime={date} class="card-date">{dateStr}</time>}
        {dateStr && readTime && <span class="meta-divider">·</span>}
        {readTime && <span class="card-readtime">{readTime}</span>}
      </div>
    )}

    <!-- Title -->
    <h3 class="card-title">{title}</h3>

    <!-- Excerpt -->
    <p class="card-excerpt">{excerpt}</p>

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="card-tags" role="list">
        {tags.map(tag => (
          <span class="card-tag" role="listitem">{tag}</span>
        ))}
      </div>
    )}

    <!-- Read CTA -->
    <div class="card-cta" aria-hidden="true">
      <span class="cta-text">Read article</span>
      <span class="cta-arrow">→</span>
    </div>

  </div>

  <!-- ── Corner accent glyph ─────────────────────────────────────────── -->
  <div class="card-corner" aria-hidden="true">✦</div>

</a>

<style>
  /* ── Card shell ─────────────────────────────────────────────────── */
  .article-card {
    /* Override glass-panel border with accent colour */
    border-color: var(--card-border) !important;
    display:      block;
    text-decoration: none;
    color:        inherit;
    position:     relative;
    overflow:     hidden;
    padding:      0;
    border-radius: 16px;

    /* Lift animation on hover */
    transform:    translateY(0px);
    transition:
      transform   0.45s cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow  0.45s cubic-bezier(0.23, 1, 0.32, 1),
      background  0.4s ease,
      border-color 0.4s ease;
  }

  .article-card:hover {
    transform:   translateY(-6px);
    box-shadow:
      0 0 0 1px var(--card-border) inset,
      0 24px 64px rgba(0,0,0,0.75),
      0 0 140px var(--card-glow),
      0 0  60px var(--card-glow);
  }

  /* ── Shimmer edge ────────────────────────────────────────────────── */
  .card-shimmer {
    position:   absolute;
    top: 0; left: -100%;
    width:  100%;
    height: 1px;
    background: linear-gradient(90deg,
      transparent,
      var(--card-tag),
      transparent
    );
    opacity: 0;
    transition: opacity 0.3s;
  }
  .article-card:hover .card-shimmer {
    opacity: 0.7;
    left:    100%;
    transition: left 0.7s ease, opacity 0.1s;
  }

  /* ── Content padding ─────────────────────────────────────────────── */
  .card-content {
    padding: 2rem 2rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* ── Meta ────────────────────────────────────────────────────────── */
  .card-meta {
    display:     flex;
    align-items: center;
    gap:         0.5rem;
    font-family: 'EB Garamond', Georgia, serif;
    font-size:   0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color:       rgba(200, 190, 220, 0.5);
  }
  .meta-divider { opacity: 0.4; }

  /* ── Title ───────────────────────────────────────────────────────── */
  .card-title {
    font-family:  'Playfair Display', Georgia, serif;
    font-size:    clamp(1.25rem, 2.5vw, 1.7rem);
    font-weight:  700;
    line-height:  1.2;
    letter-spacing: -0.02em;
    color:        rgba(238, 232, 255, 0.97);
    text-shadow:  none;  /* Suppress base layout glow on cards */
    margin-top:   0.25rem;
    transition:   color 0.3s, text-shadow 0.3s;
  }
  .article-card:hover .card-title {
    color:       #fff;
    text-shadow: 0 0 30px var(--card-glow), 0 0 60px var(--card-glow);
  }

  /* ── Excerpt ─────────────────────────────────────────────────────── */
  .card-excerpt {
    font-family: 'EB Garamond', Georgia, serif;
    font-size:   clamp(0.95rem, 1.5vw, 1.05rem);
    line-height: 1.7;
    color:       rgba(200, 192, 220, 0.72);
    display:     -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow:    hidden;
    margin:      0;
  }

  /* ── Tags ────────────────────────────────────────────────────────── */
  .card-tags {
    display:   flex;
    flex-wrap: wrap;
    gap:       0.4rem;
    margin-top: 0.25rem;
  }
  .card-tag {
    font-family:   'EB Garamond', Georgia, serif;
    font-size:     0.68rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color:         var(--card-tag);
    border:        1px solid var(--card-border);
    border-radius: 4px;
    padding:       0.2em 0.55em;
    opacity:       0.75;
    transition:    opacity 0.2s, background 0.2s;
  }
  .article-card:hover .card-tag {
    opacity:    1.0;
    background: var(--card-glow);
  }

  /* ── CTA row ─────────────────────────────────────────────────────── */
  .card-cta {
    display:     flex;
    align-items: center;
    gap:         0.5rem;
    margin-top:  0.5rem;
    font-family: 'EB Garamond', Georgia, serif;
    font-size:   0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color:       var(--card-tag);
    opacity:     0;
    transform:   translateY(4px);
    transition:  opacity 0.35s ease, transform 0.35s ease;
  }
  .article-card:hover .card-cta {
    opacity:   0.8;
    transform: translateY(0);
  }
  .cta-arrow {
    transition: transform 0.3s ease;
  }
  .article-card:hover .cta-arrow {
    transform: translateX(4px);
  }

  /* ── Corner glyph ───────────────────────────────────────────────── */
  .card-corner {
    position:    absolute;
    bottom:      1rem;
    right:       1.2rem;
    font-size:   0.7rem;
    color:       var(--card-tag);
    opacity:     0.2;
    transition:  opacity 0.3s, transform 0.6s ease;
    transform:   rotate(0deg);
    user-select: none;
  }
  .article-card:hover .card-corner {
    opacity:   0.55;
    transform: rotate(180deg);
  }
</style>
