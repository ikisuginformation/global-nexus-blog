---
// src/components/Footer.astro
// Minimal footer — matches Abyss palette. No CSS variable dependencies from the old theme.
const year = new Date().getFullYear();
---

<footer class="gn-site-footer">
    <div class="gn-site-footer-inner">
        <span class="footer-copy">© {year} Global Nexus Media</span>
        <nav class="footer-nav" aria-label="Footer navigation">
            <a href="/about">About</a>
            <a href="/privacy">Legal</a>
        </nav>
    </div>
</footer>

<style>
    .gn-site-footer {
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        padding: 2rem clamp(1.5rem, 5vw, 3rem) 5rem;
        /* 5rem bottom padding ensures content clears the mobile bottom nav */
    }

    .gn-site-footer-inner {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .footer-copy {
        font-family: 'EB Garamond', Georgia, serif;
        font-size: 0.65rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(140, 134, 126, 0.30);
    }

    .footer-nav {
        display: flex;
        gap: 2rem;
    }

    .footer-nav a {
        font-family: 'EB Garamond', Georgia, serif;
        font-size: 0.65rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(140, 134, 126, 0.30);
        text-decoration: none;
        transition: color 0.25s;
    }

    .footer-nav a:hover {
        color: rgba(185, 158, 110, 0.65);
    }
</style>