---
// src/components/QuantumCanvas.astro
// Saint Laurent / Urushi edition
// 95% abyss black. Colour exists only as memory — a ghost of lacquer
// catching light at an extreme angle. Never loud, never red.
---

<canvas id="quantum-canvas"></canvas>

<script>
  import * as THREE from 'three';

  const vertexShader = /* glsl */`
    varying vec2 vUv;
    void main() {
      vUv = uv;
      gl_Position = vec4(position, 1.0);
    }
  `;

  // ─────────────────────────────────────────────────────────────────────────────
  // FRAGMENT SHADER — Urushi / Saint Laurent
  //
  // Philosophy:
  //   The ground state is #030303 — the blackest lacquer.
  //   Colour is not painted on. It is revealed by angle, like iridescence
  //   in Japanese urushi or the sheen of a YSL gabardine.
  //
  //   Palette: warm carbon black → barely-there warm ivory → ghost gold.
  //   No cyan. No violet. No red. Only the colours of a dark room,
  //   one warm lamp, a lacquered surface.
  //
  //   All amplitude values ≤ 0.025. Max screen luminance ~0.22.
  //   Scene: a single infinite lacquer plane with micro-ripples.
  //   Mouse: barely-perceptible parallax tilt — breath on the surface.
  // ─────────────────────────────────────────────────────────────────────────────
  const fragmentShader = /* glsl */`
    precision highp float;

    uniform float u_time;
    uniform vec2  u_mouse;
    uniform vec2  u_resolution;

    varying vec2 vUv;

    // ── Noise ────────────────────────────────────────────────────────────────
    float hash21(vec2 p) {
      p = fract(p * vec2(127.1, 311.7));
      p += dot(p, p + 19.31);
      return fract(p.x * p.y);
    }

    float vnoise(vec2 p) {
      vec2 i = floor(p), f = fract(p);
      vec2 u = f * f * (3.0 - 2.0 * f);
      return mix(
        mix(hash21(i),             hash21(i + vec2(1,0)), u.x),
        mix(hash21(i + vec2(0,1)), hash21(i + vec2(1,1)), u.x),
        u.y
      ) * 2.0 - 1.0;
    }

    // 4-octave fBm — lean and precise
    float fbm(vec2 p) {
      float s = 0.0, a = 0.5;
      mat2  R = mat2(0.8, 0.6, -0.6, 0.8);
      for (int i = 0; i < 4; i++) {
        s += a * vnoise(p);
        p  = R * p * 2.03;
        a *= 0.48;
      }
      return s; // [-1, 1]
    }

    // ── Surface displacement helpers ─────────────────────────────────────────
    float lacquerHeight(vec2 xz, float t) {
      return fbm(xz * 0.28 + t * vec2(0.018, 0.011)) * 0.12
           + fbm(xz * 0.72 + t * vec2(-0.009, 0.022)) * 0.035;
    }

    vec3 lacquerNormal(vec3 pos, float t) {
      float e  = 0.018;
      float dx = lacquerHeight(pos.xz + vec2(e, 0), t)
               - lacquerHeight(pos.xz - vec2(e, 0), t);
      float dz = lacquerHeight(pos.xz + vec2(0, e), t)
               - lacquerHeight(pos.xz - vec2(0, e), t);
      return normalize(vec3(-dx / (2.0*e), 1.0, -dz / (2.0*e)));
    }

    // ── Palette — Urushi tones ────────────────────────────────────────────────
    // Shadow stays deep. Ghost is lifted so the displacement is actually visible.
    vec3 urushiTone(float t) {
      vec3 shadow = vec3(0.012, 0.010, 0.009); // deepest lacquer — unchanged
      vec3 carbon = vec3(0.048, 0.038, 0.024); // charcoal body — lifted
      vec3 ghost  = vec3(0.180, 0.135, 0.078); // warm ivory — wide gap from shadow
      vec3 c = mix(shadow, carbon, smoothstep(0.0, 0.55, t));
      return  mix(c,      ghost,  smoothstep(0.45, 1.0, t) * 0.80);
    }

    // Iridescent sheen — visible at grazing angles, not neon
    vec3 urushiSheen(float fresnel, float t) {
      float drift = sin(t * 0.07) * 0.5 + 0.5;
      vec3  warm  = vec3(0.120, 0.080, 0.030); // antique gold — 3× brighter
      vec3  cool  = vec3(0.025, 0.035, 0.055); // midnight steel — more presence
      vec3  tint  = mix(cool, warm, drift);
      float mask  = smoothstep(0.55, 1.0, fresnel); // lower threshold
      return tint * mask * 2.5; // amplitude lifted: ripples catch light
    }

    // ── Ray–plane intersection with one Newton step ───────────────────────────
    vec3 traceLacquer(vec3 ro, vec3 rd, float t,
                      out float outT, out bool hit) {
      hit  = false;
      outT = -1.0;
      if (abs(rd.y) < 0.0001) return vec3(0);

      float t0  = -ro.y / rd.y;
      if (t0 < 0.0) return vec3(0);

      vec3  p0  = ro + rd * t0;
      float d0  = lacquerHeight(p0.xz, t);
      float t1  = -(ro.y - d0) / rd.y;
      vec3  p1  = ro + rd * t1;

      hit  = true;
      outT = t1;
      return p1;
    }

    // ── Main ─────────────────────────────────────────────────────────────────
    void main() {
      float ar   = u_resolution.x / u_resolution.y;
      vec2  uv   = vUv - 0.5;
      uv.x      *= ar;

      float time = u_time * 0.65; // heavy oil — slow but visibly flowing

      // Mouse: a breath of parallax
      vec2  mouse = u_mouse - 0.5;          // [-0.5, 0.5]
      vec2  tilt  = mouse * vec2(0.18, 0.13);

      // Camera above the plane
      vec3  ro = vec3(tilt.x, 1.1, -1.8 + tilt.y);
      vec3  rd = normalize(vec3(uv * 0.82, 1.0) - vec3(tilt * 1.2, 0.0));

      // ── Base void colour ────────────────────────────────────────────────────
      vec3 col = vec3(0.011, 0.009, 0.008);

      float hitT; bool didHit;
      vec3 pos = traceLacquer(ro, rd, time, hitT, didHit);

      if (didHit) {
        vec3  nor     = lacquerNormal(pos, time);
        float fresnel = 1.0 - clamp(dot(nor, -rd), 0.0, 1.0);
        fresnel       = pow(fresnel, 3.6);

        // Reflection "sky" — also almost black, just warmer at zenith
        vec3  reflDir = reflect(rd, nor);
        float skyV    = clamp(reflDir.y, 0.0, 1.0);
        vec3  reflCol = vec3(0.018, 0.013, 0.008) * pow(skyV, 5.0)
                      + vec3(0.007, 0.006, 0.005);

        // Single warm candle source — overhead, slightly forward
        vec3  ld   = normalize(vec3(-0.2, 1.0, 0.6));
        float diff = clamp(dot(nor, ld), 0.0, 1.0) * 0.055; // lifted so diffuse shading is readable

        // Tight specular — the one jewel; power lowered slightly for a wider catch
        vec3  h    = normalize(ld - rd);
        float spec = pow(clamp(dot(nor, h), 0.0, 1.0), 140.0);
        vec3  specC = vec3(0.220, 0.170, 0.100) * spec; // warm ivory spike

        // Depth fog
        float fog = 1.0 - smoothstep(0.0, 1.0, (hitT / 20.0) * (hitT / 20.0));

        // Surface tone from displacement
        float dispT  = clamp(lacquerHeight(pos.xz, time) * 3.0 + 0.35, 0.0, 1.0);
        vec3  surf   = urushiTone(dispT);

        // Blend surface into reflection by Fresnel
        vec3  surfCol = mix(surf + vec3(diff), reflCol, fresnel * 0.50);
        surfCol      += urushiSheen(fresnel, time);
        surfCol      += specC;

        col = mix(col, surfCol, fog);

      } else {
        // Upper void — almost nothing, a ghost of a warm horizon
        float horizGrad = 1.0 - clamp(-rd.y * 5.0 + 0.4, 0.0, 1.0);
        col += vec3(0.008, 0.006, 0.003) * horizGrad * 0.35;
      }

      // Mouse breath — faint warmth where cursor rests
      float mouseLen = length(mouse);
      float mDist    = length(uv - mouse * vec2(ar, 1.0) * 0.45);
      col += vec3(0.030, 0.020, 0.010) * exp(-mDist * 5.0) * mouseLen * 0.12;

      // Vignette — the frame darkens toward edges
      col *= 0.70 + 0.30 * smoothstep(1.0, 0.30, length(vUv - 0.5) * 1.55);

      // Tonemap — Reinhard scaled, then luminance ceiling
      // Ceiling raised: 0.23 was crushing all highlights into a single flat tone.
      // Shadow lands at ~25% screen brightness, highlights reach ~50% — still dark.
      col  = (col * 4.5) / (col * 4.5 + 1.0);
      col  = pow(clamp(col, 0.0, 1.0), vec3(1.0 / 2.2));
      col  = clamp(col, 0.0, 0.50);   // Saint Laurent rule: nothing is bright

      gl_FragColor = vec4(col, 1.0);
    }
  `;

  // ─── Three.js init ───────────────────────────────────────────────────────────
  const canvas   = document.getElementById('quantum-canvas') as HTMLCanvasElement;
  const renderer = new THREE.WebGLRenderer({ canvas, antialias: false });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.0));
  renderer.setSize(window.innerWidth, window.innerHeight);

  const scene  = new THREE.Scene();
  const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

  const uniforms = {
    u_time:       { value: 0.0 },
    u_mouse:      { value: new THREE.Vector2(0.5, 0.5) },
    u_resolution: { value: new THREE.Vector2(window.innerWidth, window.innerHeight) },
  };

  scene.add(new THREE.Mesh(
    new THREE.PlaneGeometry(2, 2),
    new THREE.ShaderMaterial({ vertexShader, fragmentShader, uniforms })
  ));

  const targetMouse = new THREE.Vector2(0.5, 0.5);
  const smoothMouse = new THREE.Vector2(0.5, 0.5);

  window.addEventListener('mousemove', e => {
    targetMouse.set(
      e.clientX / window.innerWidth,
      1.0 - e.clientY / window.innerHeight
    );
  });
  window.addEventListener('touchmove', e => {
    targetMouse.set(
      e.touches[0].clientX / window.innerWidth,
      1.0 - e.touches[0].clientY / window.innerHeight
    );
  }, { passive: true });

  window.addEventListener('resize', () => {
    renderer.setSize(window.innerWidth, window.innerHeight);
    uniforms.u_resolution.value.set(window.innerWidth, window.innerHeight);
  });

  const startTime = Date.now();
  (function loop() {
    requestAnimationFrame(loop);
    smoothMouse.lerp(targetMouse, 0.06); // responsive enough to feel the warp
    uniforms.u_mouse.value.copy(smoothMouse);
    uniforms.u_time.value = (Date.now() - startTime) / 1000;
    renderer.render(scene, camera);
  })();
</script>

<style>
  #quantum-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    display: block;
    pointer-events: none;
  }
</style>