---
// src/layouts/BlogPost.astro
// "The Thesis" - 読むためだけに設計された、学術的かつ詩的な2カラムレイアウト

import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TopicScroller from '../components/TopicScroller.astro';
import AffiliateBlock from '../components/AffiliateBlock.astro';

// AIが生成したスポンサー情報も受け取れるように型を拡張
type Props = CollectionEntry<'blog'>['data'] & {
    sponsor_type?: 'TOOL' | 'BOOK' | 'SERVICE' | 'GEAR';
    sponsor_title?: string;
    sponsor_desc?: string;
    sponsor_url?: string;
};

const { 
    title, description, date, updatedDate, heroImage, language,
    sponsor_type, sponsor_title, sponsor_desc, sponsor_url 
} = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage}>
    
    <TopicScroller />

    <main class="w-full min-h-screen bg-[#FDFDFD] text-[#0A0A0A] selection:bg-[#D4AF37] selection:text-white">
        
        <article class="max-w-[1800px] mx-auto px-[5vw] pt-32 pb-48">
            
            <header class="mb-24 border-b border-black/10 pb-12">
                <div class="flex flex-col gap-6">
                    <div class="flex items-center gap-4 text-[10px] font-mono tracking-[0.3em] uppercase text-gray-400">
                        <span>Nº 001</span>
                        <span class="w-8 h-[1px] bg-gray-300"></span>
                        <span>{language || 'GLOBAL'}</span>
                    </div>
                    
                    <h1 class="text-5xl md:text-7xl lg:text-8xl font-serif font-black leading-[1.0] tracking-tighter max-w-6xl">
                        {title}
                    </h1>
                </div>
            </header>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
                
                <aside class="lg:col-span-3 lg:h-[calc(100vh-200px)] lg:sticky lg:top-32 flex flex-col gap-12 text-xs font-mono tracking-[0.1em] text-gray-500">
                    
                    <div class="flex flex-col gap-2">
                        <span class="uppercase tracking-[0.3em] text-gray-300 mb-2">Published</span>
                        <FormattedDate date={date} />
                    </div>

                    <div class="flex flex-col gap-2">
                        <span class="uppercase tracking-[0.3em] text-gray-300 mb-2">Description</span>
                        <p class="font-sans font-normal leading-relaxed text-gray-600">
                            {description}
                        </p>
                    </div>

                    <div class="flex flex-col gap-2">
                        <span class="uppercase tracking-[0.3em] text-gray-300 mb-2">Share</span>
                        <div class="flex gap-4">
                            <button class="hover:text-black transition-colors">X (Twitter)</button>
                            <button class="hover:text-black transition-colors">Copy Link</button>
                        </div>
                    </div>

                    <div class="hidden lg:block w-[1px] h-full bg-gradient-to-b from-black/10 to-transparent mt-8"></div>
                </aside>

                <div class="lg:col-span-8 lg:col-start-5">
                    <div class="prose prose-xl prose-slate max-w-none
                        prose-headings:font-serif prose-headings:text-black
                        prose-p:font-sans prose-p:font-light prose-p:text-gray-800 prose-p:leading-[2.4] prose-p:mb-12
                        prose-strong:font-medium prose-strong:text-black
                        prose-a:text-[#D4AF37] prose-a:no-underline hover:prose-a:underline
                        prose-blockquote:border-l-2 prose-blockquote:border-[#D4AF37] prose-blockquote:pl-6 prose-blockquote:italic prose-blockquote:text-gray-500
                        prose-li:marker:text-gray-300
                    ">
                        <slot />
                    </div>

                    {sponsor_title && sponsor_url && (
                        <div class="mt-32">
                            <AffiliateBlock 
                                type={sponsor_type || 'TOOL'}
                                title={sponsor_title} 
                                description={sponsor_desc || ''} 
                                url={sponsor_url} 
                            />
                        </div>
                    )}
                </div>

            </div>
        </article>

        <footer class="border-t border-black/5 py-24 text-center">
            <a href="/" class="inline-flex flex-col items-center gap-4 group">
                <span class="w-[1px] h-16 bg-gray-300 group-hover:bg-[#D4AF37] transition-colors duration-500"></span>
                <span class="text-[10px] font-mono tracking-[0.4em] uppercase text-gray-400 group-hover:text-black transition-colors">
                    Return to Void
                </span>
            </a>
        </footer>

    </main>
</BaseLayout>