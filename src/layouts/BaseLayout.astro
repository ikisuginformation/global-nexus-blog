---
// src/layouts/BaseLayout.astro
// Integrates QuantumCanvas WebGL background + glassmorphism content layer
import QuantumCanvas from '../components/QuantumCanvas.astro';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A quantum exploration of ideas.' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>

  <!-- Playfair Display — the editorial crown jewel -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap"
    rel="stylesheet"
  />

  <!-- Three.js from CDN as fallback (Astro bundler handles the import in the component) -->
</head>

<body>
  <!-- ── WebGL Abyss — fixed, behind everything ──────────────────────────── -->
  <QuantumCanvas />

  <!-- ── Ambient radial gradient overlay — softens the raw WebGL ─────────── -->
  <div class="ambient-overlay" aria-hidden="true"></div>

  <!-- ── Primary content ──────────────────────────────────────────────────── -->
  <main class="glass-main">
    <slot />
  </main>

  <!-- ── Noise grain overlay — tactile depth ────────────────────────────── -->
  <div class="grain-overlay" aria-hidden="true"></div>
</body>
</html>

<style is:global>
  /* ── Reset & tokens ───────────────────────────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    /* Urushi palette — profound abyss black */
    --c-void:        #050505;
    --c-abyss:       #0a0202;
    --c-deep:        #100303;
    --c-glass-bg:    rgba(5, 1, 1, 0.72);
    --c-glass-hover: rgba(10, 2, 1, 0.82);
    --c-glass-card:  rgba(8, 1, 1, 0.65);

    /* Urushi accents — vermilion & brushed gold */
    --c-vermilion:   #d9381e;
    --c-gold:        #d4af37;
    --c-lacquer:     #8b1a0a;
    --c-glow-red:    rgba(217, 56, 30, 0.18);
    --c-glow-gold:   rgba(212, 175, 55, 0.15);

    /* Glass borders — warm gold tint */
    --glass-border:  1px solid rgba(212, 175, 55, 0.12);
    --glass-border-strong: 1px solid rgba(212, 175, 55, 0.28);
    --glass-blur:    blur(14px) saturate(140%);

    /* Typography */
    --f-display:    'Playfair Display', Georgia, serif;
    --f-body:       'EB Garamond', Georgia, serif;
    --f-mono:       'Fira Code', 'Courier New', monospace;

    /* Spacing rhythm */
    --space-xs: 0.5rem;
    --space-s:  1rem;
    --space-m:  2rem;
    --space-l:  4rem;
    --space-xl: 8rem;
  }

  html {
    background: var(--c-void);   /* #050505 — profound Urushi abyss */
    color-scheme: dark;
    scroll-behavior: smooth;
  }

  body {
    background: transparent;
    font-family: var(--f-body);
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.75;
    color: rgba(240, 228, 208, 0.88);   /* warm cream — Urushi parchment */
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* ── Ambient overlay ──────────────────────────────────────────────────── */
  .ambient-overlay {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 50% at 20% 50%, rgba(217, 56, 30, 0.04) 0%, transparent 70%),
      radial-gradient(ellipse 60% 60% at 80% 30%, rgba(139, 26, 10, 0.05) 0%, transparent 70%),
      radial-gradient(ellipse 80% 40% at 50% 100%, rgba(5, 1, 1, 0.75) 0%, transparent 80%);
  }

  /* ── Grain overlay — adds tactile film texture ────────────────────────── */
  .grain-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    opacity: 0.028;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 256px;
  }

  /* ── Glass main container ─────────────────────────────────────────────── */
  .glass-main {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-l) var(--space-m);
  }

  /* ── Glassmorphism card base ──────────────────────────────────────────── */
  .glass-panel {
    background:     var(--c-glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border:         var(--glass-border);
    border-radius:  16px;
    box-shadow:
      0 0 0 1px rgba(212,175,55,0.04) inset,
      0 8px 32px rgba(0,0,0,0.6),
      0 0 80px rgba(217,56,30,0.03);
    transition: background 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease;
  }

  .glass-panel:hover {
    background:    var(--c-glass-hover);
    border-color:  rgba(212, 175, 55, 0.24);
    box-shadow:
      0 0 0 1px rgba(212,175,55,0.08) inset,
      0 16px 48px rgba(0,0,0,0.7),
      0 0 120px rgba(217,56,30,0.07),
      0 0 40px  rgba(212,175,55,0.05);
  }

  /* ── Typography — Bionic Reading Protocol ─────────────────────────────── */
  /* Bold the first half of each word for accelerated parsing.
     Applied via JS below (works on static content). */

  h1, h2, h3, h4 {
    font-family: var(--f-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: rgba(245, 235, 215, 0.97);   /* warm ivory — Urushi washi paper */
    /* Subtle text glow — warm ember above the lacquer */
    text-shadow:
      0 0 40px rgba(217, 56, 30, 0.15),
      0 2px 8px rgba(0,0,0,0.8);
  }

  h1 {
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 900;
    font-style: italic;
    letter-spacing: -0.03em;
    text-shadow:
      0 0 80px rgba(217, 56, 30, 0.22),
      0 0 160px rgba(212, 175, 55, 0.12),
      0 4px 16px rgba(0,0,0,0.9);
  }

  h2 { font-size: clamp(2rem, 5vw, 3.8rem); }
  h3 { font-size: clamp(1.4rem, 3vw, 2.2rem); }

  p { font-family: var(--f-body); }

  /* Bionic bold spans */
  b.bionic {
    font-weight: 700;
    color: rgba(255, 245, 225, 1.0);   /* warm white */
  }

  /* ── Links ────────────────────────────────────────────────────────────── */
  a {
    color: var(--c-gold);
    text-decoration: none;
    transition: color 0.2s, text-shadow 0.2s;
  }
  a:hover {
    color: #fff5e0;
    text-shadow: 0 0 20px rgba(212, 175, 55, 0.6);
  }

  /* ── Site header ────────────────────────────────────────────────────────── */
  .site-header {
    padding: var(--space-l) 0 var(--space-m);
    border-bottom: 1px solid rgba(212, 175, 55, 0.10);
    margin-bottom: var(--space-l);
  }

  .site-header .eyebrow {
    font-size: 0.7rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--c-gold);
    opacity: 0.7;
    margin-bottom: var(--space-xs);
  }

  /* ── Article grid ──────────────────────────────────────────────────────── */
  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    gap: var(--space-m);
    margin-top: var(--space-l);
  }

  /* ── Scrollbar styling ─────────────────────────────────────────────────── */
  ::-webkit-scrollbar { width: 4px; }
  ::-webkit-scrollbar-track { background: var(--c-abyss); }
  ::-webkit-scrollbar-thumb { background: rgba(212, 175, 55, 0.30); border-radius: 2px; }

  /* ── Selection ─────────────────────────────────────────────────────────── */
  ::selection {
    background: rgba(217, 56, 30, 0.35);
    color: #fff5e0;
  }

  /* ── Utility: glow accent line ─────────────────────────────────────────── */
  .glow-rule {
    border: none;
    height: 1px;
    background: linear-gradient(90deg,
      transparent,
      rgba(217, 56, 30, 0.50) 30%,
      rgba(212, 175, 55, 0.50) 70%,
      transparent
    );
    margin: var(--space-l) 0;
  }
</style>

<!-- Bionic Reading: bold first ~55% of each word's letters in all text nodes -->
<script>
  function bionicNode(node: Text) {
    const words = node.textContent?.split(/(\s+)/) ?? [];
    if (words.length < 2) return;

    const frag = document.createDocumentFragment();
    for (const word of words) {
      if (/^\s+$/.test(word)) {
        frag.appendChild(document.createTextNode(word));
      } else {
        const cut = Math.max(1, Math.ceil(word.length * 0.55));
        const b = document.createElement('b');
        b.className = 'bionic';
        b.textContent = word.slice(0, cut);
        frag.appendChild(b);
        frag.appendChild(document.createTextNode(word.slice(cut)));
      }
    }
    node.replaceWith(frag);
  }

  function applyBionic(root: Element) {
    // Only apply to <p> and <li> tags — not headings (Playfair handles those)
    const walker = document.createTreeWalker(
      root,
      NodeFilter.SHOW_TEXT,
      {
        acceptNode(node) {
          const p = node.parentElement;
          if (!p) return NodeFilter.FILTER_REJECT;
          const tag = p.tagName.toLowerCase();
          if (['p', 'li', 'td', 'blockquote'].includes(tag)) return NodeFilter.FILTER_ACCEPT;
          return NodeFilter.FILTER_SKIP;
        }
      }
    );
    const nodes: Text[] = [];
    let n: Node | null;
    while ((n = walker.nextNode())) nodes.push(n as Text);
    nodes.forEach(bionicNode);
  }

  document.addEventListener('DOMContentLoaded', () => applyBionic(document.body));
</script>