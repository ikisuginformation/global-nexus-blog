---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SearchOverlay from '../components/SearchOverlay.astro';

const posts = (await getCollection('blog')).sort((a, b) => {
    const dateA = a.data.date ? new Date(a.data.date).valueOf() : 0;
    const dateB = b.data.date ? new Date(b.data.date).valueOf() : 0;
    return dateB - dateA;
});

const heroPost = posts[0];
const gridPosts = posts.slice(1);
---

<BaseLayout title="Global Nexus" description="Intelligence from the intersection of technology, capital, and culture." fullBleed={true}>

    <SearchOverlay />

    <!-- Hero — full-bleed, no container -->
    {heroPost && (
        <a href={`/blog/${heroPost.slug}/`} class="hero-link" aria-label={`Read: ${heroPost.data.title}`}>
            <section class="gn-hero">
                <div class="hero-inner">
                    <div class="hero-eyebrow">
                        <span class="pulse-dot" aria-hidden="true"></span>
                        <span>Latest</span>
                    </div>
                    <h1 class="hero-title">{heroPost.data.title}</h1>
                    {heroPost.data.description && (
                        <p class="hero-description">{heroPost.data.description}</p>
                    )}
                    <span class="hero-cta">Read →</span>
                </div>
            </section>
        </a>
    )}

    <!-- Section header -->
    <div class="section-header">
        <div class="section-header-inner">
            <span class="section-label">Archive</span>
            <button class="open-search-btn section-search" aria-label="Search">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="7.5"/><line x1="17" y1="17" x2="22.5" y2="22.5"/>
                </svg>
                <span>Search</span>
            </button>
        </div>
    </div>

    <!-- Article grid -->
    {gridPosts.length > 0 ? (
        <div class="gn-gallery">
            {gridPosts.map((post, i) => (
                <ArticleCard post={post} index={i} />
            ))}
        </div>
    ) : (
        <div class="empty-state">
            <p>No articles yet. The engine is running.</p>
        </div>
    )}

    <!-- Footer -->
    <footer class="gn-footer">
        <div class="gn-footer-inner">
            <span class="gn-footer-copy">© {new Date().getFullYear()} Global Nexus Media</span>
            <div class="gn-footer-links">
                <a href="/about">About</a>
                <a href="/privacy">Legal</a>
            </div>
        </div>
    </footer>

</BaseLayout>

<style>
    /* ── Hero ────────────────────────────────────────────────────────────────── */
    .hero-link {
        display: block;
        text-decoration: none;
        color: inherit;
    }

    .gn-hero {
        position: relative;
        min-height: 85vh;
        display: flex;
        align-items: flex-end;
        padding: clamp(3rem, 8vh, 6rem) clamp(1.5rem, 6vw, 6rem);
        border-bottom: 1px solid rgba(255,255,255,0.05);
        cursor: pointer;
        transition: background 0.6s ease;
    }

    .gn-hero:hover {
        background: rgba(5, 4, 9, 0.25);
    }

    .hero-inner {
        max-width: 900px;
        position: relative;
        z-index: 1;
    }

    .hero-eyebrow {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        font-family: 'EB Garamond', Georgia, serif;
        font-size: 0.68rem;
        letter-spacing: 0.30em;
        text-transform: uppercase;
        color: rgba(185, 158, 110, 0.65);
        margin-bottom: 2rem;
    }

    .pulse-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: rgba(185, 158, 110, 0.8);
        animation: pulse 2.5s ease-in-out infinite;
    }

    @keyframes pulse {
        0%, 100% { opacity: 0.4; transform: scale(1); }
        50%       { opacity: 1.0; transform: scale(1.3); }
    }

    .hero-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(2.8rem, 7vw, 6.5rem);
        font-weight: 900;
        font-style: italic;
        line-height: 1.04;
        letter-spacing: -0.02em;
        color: rgba(230, 224, 215, 0.96);
        text-shadow: none;
        margin-bottom: 1.5rem;
        max-width: 820px;
    }

    .hero-description {
        font-family: 'EB Garamond', Georgia, serif;
        font-size: clamp(1.05rem, 1.8vw, 1.3rem);
        line-height: 1.65;
        color: rgba(155, 148, 138, 0.75);
        max-width: 600px;
        margin-bottom: 2rem;
    }

    .hero-cta {
        font-family: 'EB Garamond', Georgia, serif;
        font-size: 0.72rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(185, 158, 110, 0.60);
        transition: color 0.3s ease;
    }

    .gn-hero:hover .hero-cta {
        color: rgba(185, 158, 110, 0.90);
    }

    /* ── Section header ─────────────────────────────────────────────────────── */
    .section-header {
        padding: 0 clamp(1.5rem, 6vw, 6rem);
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .section-header-inner {
        max-width: 1400px;
        margin: 0 auto;
        height: 3.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .section-label {
        font-family: 'EB Garamond', Georgia, serif;
        font-size: 0.65rem;
        letter-spacing: 0.35em;
        text-transform: uppercase;
        color: rgba(140, 134, 126, 0.45);
    }

    .section-search {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        background: none;
        border: none;
        cursor: pointer;
        font-family: 'EB Garamond', Georgia, serif;
        font-size: 0.65rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: rgba(140, 134, 126, 0.45);
        padding: 0;
        transition: color 0.25s;
    }

    .section-search:hover {
        color: rgba(185, 158, 110, 0.75);
    }

    /* ── Gallery grid ────────────────────────────────────────────────────────── */
    .gn-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(360px, 100%), 1fr));
        perspective: 1200px;
        padding: clamp(1.5rem, 4vw, 3rem) clamp(1.5rem, 6vw, 6rem);
        gap: 0;
        max-width: 1600px;
        margin: 0 auto;
    }

    /* ── Empty state ─────────────────────────────────────────────────────────── */
    .empty-state {
        padding: 8rem clamp(1.5rem, 6vw, 6rem);
        font-family: 'EB Garamond', Georgia, serif;
        font-size: 0.72rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: rgba(140, 134, 126, 0.35);
    }

    /* ── Footer ──────────────────────────────────────────────────────────────── */
    .gn-footer {
        border-top: 1px solid rgba(255,255,255,0.05);
        padding: 2.5rem clamp(1.5rem, 6vw, 6rem);
        margin-top: 2rem;
    }

    .gn-footer-inner {
        max-width: 1600px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .gn-footer-copy {
        font-family: 'EB Garamond', Georgia, serif;
        font-size: 0.65rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(140, 134, 126, 0.35);
    }

    .gn-footer-links {
        display: flex;
        gap: 2rem;
    }

    .gn-footer-links a {
        font-family: 'EB Garamond', Georgia, serif;
        font-size: 0.65rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(140, 134, 126, 0.35);
        text-decoration: none;
        transition: color 0.25s;
    }

    .gn-footer-links a:hover {
        color: rgba(185, 158, 110, 0.65);
    }

    @media (max-width: 767px) {
        .gn-hero {
            min-height: 70vh;
            padding-bottom: 5rem;
        }
        .gn-gallery {
            padding: 0;
        }
    }
</style>