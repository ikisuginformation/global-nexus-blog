---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const hero        = posts[0];
const galleryPosts = posts.slice(1);

const heroDate = hero?.data.date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<BaseLayout title="Global Nexus" fullBleed>

  {/* ── HERO: Centric Focus ─────────────────────────────────────────────────── */}
  {hero && (
    <section class="gn-hero">
      <a href={`/blog/${hero.slug}/`} class="hero-link" aria-label={hero.data.title}>
        <div class="hero-inner">
          <span class="hero-eyebrow">{heroDate} · Global Nexus</span>
          <h1 class="hero-title">{hero.data.title}</h1>
          {hero.data.description && (
            <p class="hero-excerpt">{hero.data.description}</p>
          )}
          <span class="hero-cta" aria-hidden="true">Read Article &rarr;</span>
        </div>
      </a>
    </section>
  )}

  {/* ── GALLERY: Floating Irregular Grid ─────────────────────────────────────── */}
  {galleryPosts.length > 0 && (
    <section class="gn-gallery-section">
      <div class="section-rule" aria-hidden="true"></div>
      <div class="gn-gallery">
        {galleryPosts.map((post, i) => (
          <ArticleCard post={post} index={i} />
        ))}
      </div>
    </section>
  )}

</BaseLayout>

<style>
  /* ── Hero — Centric Focus ─────────────────────────────────────────────────── */
  .gn-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* Subtle radial darkening directly behind the title block — not a box */
  .gn-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 65% 45% at 50% 52%,
      rgba(3, 2, 5, 0.32) 0%,
      transparent 72%
    );
    pointer-events: none;
    z-index: 0;
  }

  /* Gradient dissolve into gallery section */
  .gn-hero::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 28%;
    background: linear-gradient(to bottom, transparent, rgba(3, 2, 5, 0.80));
    pointer-events: none;
    z-index: 0;
  }

  .hero-link {
    display: block;
    width: 100%;
    position: relative;
    z-index: 1;
    color: inherit;
    text-decoration: none;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 10rem 2rem 9rem;
    max-width: 880px;
    margin: 0 auto;
  }

  .hero-eyebrow {
    display: block;
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 0.68rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(185, 158, 110, 0.65);
    margin-bottom: 2.2rem;
  }

  .hero-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(3.2rem, 9vw, 9.5rem);
    font-weight: 900;
    font-style: italic;
    /* Wide letter-spacing: the Urushi curated luxury feel */
    letter-spacing: 0.08em;
    line-height: 1.0;
    color: rgba(230, 224, 215, 0.97);
    text-shadow: none;
    margin-bottom: 2.5rem;
    transition: color 0.4s ease;
  }

  .hero-link:hover .hero-title {
    color: rgba(245, 239, 229, 1.0);
  }

  .hero-excerpt {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    line-height: 1.7;
    color: rgba(185, 178, 168, 0.72);
    max-width: 560px;
    margin-bottom: 3rem;
  }

  .hero-cta {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 0.70rem;
    letter-spacing: 0.30em;
    text-transform: uppercase;
    color: rgba(185, 158, 110, 0.55);
    transition: color 0.35s ease, letter-spacing 0.35s ease;
  }

  .hero-link:hover .hero-cta {
    color: rgba(215, 188, 140, 0.88);
    letter-spacing: 0.38em;
  }

  /* ── Gallery Section ──────────────────────────────────────────────────────── */
  .gn-gallery-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4vw, 3rem) 8rem;
  }

  .section-rule {
    height: 1px;
    background: rgba(185, 158, 110, 0.14);
    margin-bottom: 4rem;
  }

  /* ── Floating Gallery Grid ────────────────────────────────────────────────── */
  /* 3-column on desktop, irregular 2-1 / 1-2 row pattern */
  .gn-gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;           /* No gap — cards float freely, borders via ::after */
    perspective: 1100px;
    perspective-origin: 50% 30%;
  }

  /*
    Irregular span pattern (4-item cycle on a 3-col grid):
    Item 1 (4n+1): span 2 → cols 1–2
    Item 2 (4n+2): span 1 → col  3
    Item 3 (4n+3): span 1 → col  1
    Item 4 (4n+0): span 2 → cols 2–3   ← row ends, next row repeats
  */
  .gn-gallery :global(.article-card:nth-child(4n+1)),
  .gn-gallery :global(.article-card:nth-child(4n))   {
    grid-column: span 2;
  }

  /* ── Mobile overrides ─────────────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .gn-hero {
      min-height: 90vh;
      align-items: flex-end;
    }

    .hero-inner {
      align-items: flex-start;
      text-align: left;
      padding: 4rem 1.5rem 6rem;   /* 6rem bottom clears the fixed bottom nav */
    }

    .hero-title {
      font-size: clamp(2.6rem, 10vw, 4.5rem);
      letter-spacing: 0.04em;
      line-height: 1.05;
    }

    .hero-excerpt { font-size: 1rem; max-width: 100%; }

    .gn-gallery-section {
      padding: 0 0 5rem;           /* edge-to-edge on mobile */
    }

    .gn-gallery {
      grid-template-columns: 1fr;
      perspective: none;
    }

    /* Reset all irregular spans on mobile */
    .gn-gallery :global(.article-card:nth-child(4n+1)),
    .gn-gallery :global(.article-card:nth-child(4n)) {
      grid-column: span 1;
    }
  }

  /* ── Reduced motion ───────────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .hero-title, .hero-cta { transition: none; }
  }
</style>
