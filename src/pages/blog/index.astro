---
import { getCollection } from 'astro:content';

// 記事データを取得（エラーが出ないよう安全にソート）
const posts = (await getCollection('blog')).sort((a, b) => {
    const dateA = a.data.date ? new Date(a.data.date).valueOf() : 0;
    const dateB = b.data.date ? new Date(b.data.date).valueOf() : 0;
    return dateB - dateA;
});
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>Global Nexus Blog</title>
    </head>
    <body>
        <h1>Article List</h1>
        <ul>
            {
                posts.map((post) => (
                    <li>
                        <a href={`/blog/${post.slug}/`}>{post.data.title || 'Untitled'}</a>
                    </li>
                ))
            }
        </ul>
    </body>
</html>