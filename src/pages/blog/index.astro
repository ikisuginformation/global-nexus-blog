---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';

// 日付順にソート（安全装置付き）
const posts = (await getCollection('blog')).sort(
	(a, b) => {
		const dateA = a.data.date ? new Date(a.data.date).valueOf() : 0;
		const dateB = b.data.date ? new Date(b.data.date).valueOf() : 0;
		return dateB - dateA;
	}
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Global Nexus Blog" description="Latest articles generated by AI" />
		<style>
			main { width: 960px; max-width: 100%; margin: 0 auto; padding: 2rem; }
			ul { list-style-type: none; padding: 0; }
			li { margin-bottom: 2rem; border-bottom: 1px solid #eee; padding-bottom: 1rem; }
			.title { font-size: 1.5rem; margin: 0 0 0.5rem 0; color: #333; }
			.date { color: #888; font-size: 0.9rem; margin: 0; }
			a { text-decoration: none; }
			a:hover .title { color: #0056b3; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.slug}/`}>
									<h4 class="title">{post.data.title || 'Untitled Article'}</h4>
									<p class="date">
										{post.data.date ? <FormattedDate date={post.data.date} /> : 'Recent'}
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>