---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import FormattedDate from '../../../../components/FormattedDate.astro';

export async function getStaticPaths() {
	const allPosts = await getCollection('blog');
	
	// タグを収集（重複排除・空タグ排除）
	const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags || []).flat())];

	return uniqueTags.map((tag) => {
		// そのタグを含む記事だけをフィルタリング
		const filteredPosts = allPosts.filter((post) => 
			(post.data.tags || []).includes(tag)
		).sort(
			(a, b) => (b.data.date?.valueOf() || 0) - (a.data.date?.valueOf() || 0)
		);

		return {
			params: { tag },
			props: { posts: filteredPosts },
		};
	});
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={`Posts tagged with ${tag}`} description={`Articles regarding ${tag}`}>
	<Header />
	<main style="max-width: 960px; margin: 0 auto; padding: 2rem;">
		<h1 style="margin-bottom: 2rem; font-size: 2rem;">Tag: <span style="color: #d946ef;">#{tag}</span></h1>
		
		<ul style="list-style: none; padding: 0;">
			{
				posts.map((post) => (
					<li style="margin-bottom: 2rem; border-bottom: 1px solid #eee; padding-bottom: 1rem;">
						<a href={`/blog/${post.slug}/`} style="text-decoration: none; display: block;">
							<h3 style="margin: 0; color: #333; font-size: 1.5rem;">{post.data.title || 'Untitled'}</h3>
							<p style="margin: 0.5rem 0; color: #666;">
								{post.data.date ? <FormattedDate date={post.data.date} /> : ''}
							</p>
						</a>
					</li>
				))
			}
		</ul>
		
		<div style="margin-top: 3rem;">
			<a href="/blog" style="color: #666; text-decoration: underline;">← Back to all articles</a>
		</div>
	</main>
	<Footer />
</BaseLayout>