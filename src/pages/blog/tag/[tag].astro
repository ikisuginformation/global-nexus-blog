---
// src/pages/blog/tag/[tag].astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import TopicScroller from '../../../components/TopicScroller.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags || []).flat())];

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts.filter((post) => post.data.tags?.includes(tag))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
    
    return {
      // URLを安全な形式（小文字・ハイフン）に変換
      params: { tag: tag.toLowerCase().replace(/\s+/g, '-') },
      props: { posts: filteredPosts, tagName: tag },
    };
  });
}

const { tag } = Astro.params;
const { posts, tagName } = Astro.props;
---

<BaseLayout title={`${tagName} | Fluctuation`} description={`Archive of ${tagName}`}>
    <TopicScroller />

    <main class="w-full min-h-screen bg-[#FDFDFD] pt-[25vh] pb-48 selection:bg-[#0A0A0A] selection:text-white">
        <div class="max-w-[1600px] mx-auto px-[10vw]">
            
            <header class="mb-32">
                <p class="text-[10px] font-mono tracking-[0.3em] text-gray-400 uppercase mb-4 border-l border-black/10 pl-4">
                    Intelligence Archive / Tag
                </p>
                <h1 class="text-5xl md:text-7xl font-serif font-light tracking-tighter text-[#0A0A0A] uppercase max-w-4xl">
                    {tagName}
                </h1>
                <p class="mt-8 text-sm text-gray-500">
                    {posts.length} insights accumulated.
                </p>
            </header>
            
            <div class="flex flex-col gap-y-24 w-full">
                {posts.map((post, index) => {
                    const isLeft = index % 2 === 0;
                    const alignmentClass = isLeft ? 'self-start md:ml-[5vw]' : 'self-end md:mr-[5vw]';
                    return (
                        <div class={`w-full md:w-[45vw] ${alignmentClass} transition-transform duration-1000 ease-out hover:-translate-y-2`}>
                            <ArticleCard post={post} />
                        </div>
                    );
                })}
            </div>

        </div>
    </main>
</BaseLayout>