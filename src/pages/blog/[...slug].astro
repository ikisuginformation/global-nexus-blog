---
// src/pages/blog/[...slug].astro
// [...slug] = スプレッドルート。"en/article-name" のような2段階パスに対応。

import { getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  let allPosts: any[] = [];

  try {
    allPosts = await getCollection('blog');
  } catch {
    try {
      allPosts = await getCollection('posts');
    } catch {
      allPosts = [];
    }
  }

  return allPosts.map((post) => ({
    // post.slug = "en/article-name" → 配列 ["en", "article-name"] に分割
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const fm = post.data;
---

<BlogPost
  title={fm.title}
  description={fm.description ?? ''}
  pubDate={fm.pubDate ?? fm.date ?? new Date().toISOString()}
  updatedDate={fm.updatedDate}
  category={fm.category ?? 'Analysis'}
  categorySlug={fm.categorySlug ?? 'analysis'}
  articleId={fm.articleId ?? post.slug}
  readingMinutes={fm.readingMinutes ?? 5}
  heroImage={fm.heroImage}
  verdict={fm.verdict}
  relatedTools={fm.relatedTools ?? []}
  tags={fm.tags ?? []}
  affiliateDisclosure={fm.affiliateDisclosure ?? false}
>
  <Content />
</BlogPost>
