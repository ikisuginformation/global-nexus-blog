---
// src/pages/go/[slug].astro
// Affiliate redirect handler
// All /go/{slug} links pass through here for tracking + disclosure

const AFFILIATES: Record<string, { url: string; name: string; disclosure: string }> = {
  "semrush":      { url: "https://www.semrush.com/", name: "Semrush", disclosure: "We earn a commission on Semrush purchases through this link." },
  "ahrefs":       { url: "https://ahrefs.com/", name: "Ahrefs", disclosure: "We earn a commission on Ahrefs purchases through this link." },
  "nordvpn":      { url: "https://nordvpn.com/", name: "NordVPN", disclosure: "We earn a commission on NordVPN purchases through this link." },
  "expressvpn":   { url: "https://www.expressvpn.com/", name: "ExpressVPN", disclosure: "We earn a commission on ExpressVPN purchases through this link." },
  "surfer-seo":   { url: "https://surferseo.com/", name: "Surfer SEO", disclosure: "We earn a commission on Surfer SEO purchases through this link." },
  "similarweb":   { url: "https://www.similarweb.com/", name: "SimilarWeb", disclosure: "We earn a commission on SimilarWeb purchases through this link." },
  "mozpro":       { url: "https://moz.com/products/pro", name: "Moz Pro", disclosure: "We earn a commission on Moz purchases through this link." },
};

const { slug } = Astro.params;
const affiliate = slug ? AFFILIATES[slug] : undefined;

// If not found, redirect to tools page
if (!affiliate) {
  return Astro.redirect('/tools', 301);
}
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Redirecting to {affiliate.name} — Global Nexus</title>
<meta name="robots" content="noindex,nofollow"/>
<!-- Redirect after 1.5s to allow disclosure display -->
<meta http-equiv="refresh" content={`2;url=${affiliate.url}`}/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400&display=swap" rel="stylesheet"/>
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:#F2EDE3;display:flex;align-items:center;justify-content:center;min-height:100vh;font-family:'DM Mono','Courier New',monospace}
  .card{max-width:480px;padding:55px;border:1px solid rgba(28,23,16,.08);background:#ECE7DC;text-align:center}
  .eyebrow{font-size:.40rem;letter-spacing:.26em;text-transform:uppercase;color:#C8BBAA;margin-bottom:21px}
  .name{font-size:1.2rem;color:#1C1710;margin-bottom:13px;font-family:'Georgia',serif;font-style:italic}
  .disc{font-size:.36rem;letter-spacing:.12em;text-transform:uppercase;color:#A09080;line-height:1.8;margin-bottom:21px}
  .cta{display:inline-block;font-size:.44rem;letter-spacing:.18em;text-transform:uppercase;color:#F2EDE3;background:#506845;padding:8px 21px;text-decoration:none}
  .bar{width:100%;height:2px;background:rgba(28,23,16,.08);margin-bottom:21px;overflow:hidden}
  .bar-fill{height:100%;background:#506845;animation:fill 2s linear forwards}
  @keyframes fill{from{width:0}to{width:100%}}
</style>
</head>
<body>
<div class="card">
  <div class="bar"><div class="bar-fill"></div></div>
  <div class="eyebrow">Affiliate disclosure</div>
  <div class="name">Redirecting to {affiliate.name}</div>
  <p class="disc">{affiliate.disclosure}<br/>Global Nexus earns a commission at no extra cost to you.<br/>This does not influence our editorial analysis.</p>
  <a href={affiliate.url} class="cta">Continue to {affiliate.name} →</a>
</div>
</body>
</html>
