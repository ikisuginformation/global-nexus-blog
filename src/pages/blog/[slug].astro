---
// src/pages/blog/[slug].astro
// 多言語対応ルーティング: /blog/[slug] → src/content/blog/{lang}/{slug}.md

import { getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  // content/blog コレクションの全記事を取得
  // ファイルパス: src/content/blog/{lang}/{slug}.md
  // Astroのslugは lang/slug になる (例: "en/my-article")
  let allPosts: any[] = [];

  try {
    allPosts = await getCollection('blog');
  } catch {
    // 'blog' コレクションがない場合は 'posts' を試みる
    try {
      allPosts = await getCollection('posts');
    } catch {
      allPosts = [];
    }
  }

  return allPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const fm = post.data;
---

<BlogPost
  title={fm.title}
  description={fm.description ?? ''}
  pubDate={fm.pubDate ?? fm.date ?? new Date().toISOString()}
  updatedDate={fm.updatedDate}
  category={fm.category ?? 'Analysis'}
  categorySlug={fm.categorySlug ?? 'analysis'}
  articleId={fm.articleId ?? post.slug}
  readingMinutes={fm.readingMinutes ?? 5}
  heroImage={fm.heroImage}
  verdict={fm.verdict}
  relatedTools={fm.relatedTools ?? []}
  tags={fm.tags ?? []}
  affiliateDisclosure={fm.affiliateDisclosure ?? false}
>
  <Content />
</BlogPost>